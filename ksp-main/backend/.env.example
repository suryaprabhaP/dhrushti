# ==============================================================================
# KSP Sentinel AI — Environment Variables for Zoho Catalyst Deployment
# ==============================================================================
# Copy this file to .env for local development.
# In Zoho Catalyst Console → App Service → Environment Variables,
# set each key-value pair listed below.
#
# REQUIRED fields must be set for the app to function correctly.
# OPTIONAL fields enable specific features but are not mandatory.
# ==============================================================================

# --- [REQUIRED] LLM API Providers ---
# At least one of GROQ_API_KEY or GEMINI_API_KEY must be set for LLM responses.
# Without these, the AI chat will fall back to offline rule-based answers.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- [REQUIRED] Server Port ---
# Zoho Catalyst App Service injects PORT automatically. Default is 8080.
PORT=8080

# --- [OPTIONAL] Zoho Catalyst / QuickML Credentials ---
# Required for Zoho Zia AI features (face analytics, OCR, identity scanner).
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
client_id=
client_secret=
ZOHO_AUTH_CODE=
ZOHO_API_DOMAIN=https://www.zohoapis.in

# --- [AUTO-SET BY CATALYST] Project Identifiers ---
CATALYST_PROJECT_ID=54626000000013049
CATALYST_ORG_ID=60077159195

# --- [FRONTEND] API Base URL ---
VITE_API_BASE_URL=http://localhost:5000/agent_api
